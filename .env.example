# Rojgar Setu (रोजगार सेतु) - Environment Template
# Copy this file to .env and fill in your credentials

DEBUG=True
SECRET_KEY=django-insecure-rojgar-setu-p2p-hyperlocal-key-2026

# ========================================================
# Supabase PostgreSQL + PostGIS Connection
# ========================================================
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>?sslmode=require
DIRECT_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?sslmode=require

DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.<project_ref>
DB_PASSWORD=<your_db_password>
DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# ========================================================
# Google Gemini Flash AI Screening & Dynamic Contract Engine
# Get your API key at: https://aistudio.google.com/api-keys
# ========================================================
GEMINI_API_KEY=<your_gemini_api_key_here>
GEMINI_MODEL=gemini-flash-latest

# ========================================================
# DigiLocker Sandbox Verification Gateway
# ========================================================
DIGILOCKER_CLIENT_ID=sandbox_client_rojgar_setu
DIGILOCKER_SECRET=sandbox_secret_aadhaar_verify
